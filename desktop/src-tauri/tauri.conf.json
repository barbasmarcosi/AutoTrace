{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoTrace",
  "version": "0.1.0",
  "identifier": "ar.com.autotrace.desktop",
  "build": {
    "frontendDist": "../../site"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoTrace · Gestión de taller",
        "width": 1180,
        "height": 790,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../site/assets/icon-512.png"]
  }
}
